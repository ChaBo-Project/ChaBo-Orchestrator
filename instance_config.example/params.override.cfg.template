# Tier-1 pipeline-behavior configuration template for a ChaBo instance.
#
# Layered on top of the published image's baked-in params.cfg via
# configparser.read([base, override]) — only keys you uncomment/set here
# override the generic default; everything else falls through unchanged.
# Full contract: chabo/README.md's "Instance Configuration" section.
# Every section/key below mirrors params.cfg exactly, so nothing is hidden —
# uncomment and fill in whatever this instance actually needs to override.
#
# Sections/keys left active (not commented) are REQUIRED for a working deploy.
# Everything commented out is optional — leave it that way to inherit the base
# image's default, or uncomment and fill in to override it.
#
# [ragas] is intentionally not included here — it's eval-only (tests/eval/eval.py),
# never read by the running application, so it has no place in a deploy instance's config.

[hf_endpoints]
embedding_endpoint_url = ${EMBEDDING_ENDPOINT_URL}
reranker_endpoint_url = ${RERANKER_ENDPOINT_URL}

[qdrant]
mode = gradio
url = ${QDRANT_URL}
collection = ${COLLECTION_NAME}
port = 443

[retrieval]
# Optional — uncomment and adjust any of these to override the base defaults;
# safe to leave the whole section commented to inherit them as-is.
# top_k = 20
# reranker_enabled = true
# reranker_top_k = 5
# hybrid_enabled = false
# prefetch_top_k = 100
# sparse_model = Qdrant/bm25
# sparse_language = english
# dense_weight = 0.5
# sparse_weight = 0.5
# rrf_k = 60

[generator]
PROVIDER = ${GENERATOR_PROVIDER}
MODEL = ${GENERATOR_MODEL}
MAX_TOKENS = ${GENERATOR_MAX_TOKENS}
TEMPERATURE = ${GENERATOR_TEMPERATURE}
CONTEXT_META_FIELDS = ${CONTEXT_META_FIELDS}

# These values are required when Hugging Face is the generator provider.
INFERENCE_PROVIDER = ${GENERATOR_INFERENCE_PROVIDER}
ORGANIZATION = ${GENERATOR_ORGANIZATION}

# Metadata fields displayed with generated answers.
TITLE_META_FIELDS = ${TITLE_META_FIELDS}

# Required only when Azure is the generator provider.
AZURE_ENDPOINT = ${AZURE_ENDPOINT}

[metadata_filters]
# Optional feature, off by default — leaving filterable_fields empty/commented
# makes extract_filters_node a pass-through. To enable: set filterable_fields AND
# fill in the llm_* keys below AND add matching entries under `filters:` in
# instance.yaml.
# Types: str, int, list.
# filterable_fields = <field>:<type>,...
filterable_fields = ${FILTERABLE_FIELDS}
# llm_provider = huggingface
# llm_model = provider-specific-model
# llm_max_tokens = 256
# llm_temperature = 0.1
# llm_inference_provider = <required for huggingface>
# llm_organization = <required for huggingface

[query_rewriter]
# Set QUERY_REWRITER_ENABLED=false in deploy.env to disable this feature.
enabled = ${QUERY_REWRITER_ENABLED}

# Empty means that no cross-language rewriting is performed.
# target_language =

llm_provider = ${QUERY_REWRITER_LLM_PROVIDER}
llm_model = ${QUERY_REWRITER_LLM_MODEL}
llm_max_tokens = ${QUERY_REWRITER_LLM_MAX_TOKENS}
llm_temperature = ${QUERY_REWRITER_LLM_TEMPERATURE}

# Required when Hugging Face is the query-rewriter provider.
llm_inference_provider = ${QUERY_REWRITER_LLM_INFERENCE_PROVIDER}
llm_organization = ${QUERY_REWRITER_LLM_ORGANIZATION}

# Query-rewriter grounding is configured in instance.yaml under db_context.

[input_guard]
# Optional feature, off by default.
enabled = false
# mode = llm
# Required for mode = classifier.
# endpoint_url =
# llm_provider = huggingface
# llm_model = provider-specific-model
# llm_max_tokens = 64
# llm_temperature = 0.0
# llm_inference_provider = <required for huggingface>
# llm_organization = <required for huggingface>
# block_controversial = false
# timeout_s = 2.0
# blocked_message = I'm sorry, but I can't help with that request.

[output_guard]
# Two independent sub-features, both off by default.
classification_enabled = false
# mode = llm
# endpoint_url =
# model = Qwen/Qwen3Guard-Gen-0.6B
# llm_provider = huggingface
# llm_model = provider-specific-model
# llm_max_tokens = 16
# llm_temperature = 0.0
# llm_inference_provider = <required for huggingface>
# llm_organization = <required for huggingface>
# window_chars = 200
# block_controversial = true
# timeout_s = 5.0
# classification_message = This application is not able to answer certain queries. Please try again.
# guideline_enforcement = off

blocklist_enabled = false
# blocklist_path = src/components/guardrails/blocklist.txt
# blocklist_message = There was an error in the output. Please try again.
